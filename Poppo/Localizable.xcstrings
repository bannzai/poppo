{
  "sourceLanguage" : "en",
  "strings" : {
    "Allow access to all photos in Settings to see new screenshots" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しく撮ったスクリーンショットを並べるには設定ですべての写真へのアクセスを許可してください"
          }
        }
      }
    },
    "Allow photo access" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真へのアクセスを許可"
          }
        }
      }
    },
    "Allow photo access to see your recent screenshots here" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真へのアクセスを許可すると直近のスクリーンショットがここに並びます"
          }
        }
      }
    },
    "Copied" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーしました"
          }
        }
      }
    },
