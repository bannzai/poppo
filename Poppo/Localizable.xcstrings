{
  "sourceLanguage" : "en",
  "strings" : {
    "Agree and start" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意して始める"
          }
        }
      }
    },
    "Allow access to all photos in Settings to see new photos and videos" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しく保存した写真と動画を並べるには設定ですべての写真へのアクセスを許可してください"
          }
        }
      }
    },
    "Allow access to all photos in Settings to see new screenshots" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しく撮ったスクリーンショットを並べるには設定ですべての写真へのアクセスを許可してください"
          }
        }
      }
    },
    "Allow photo access" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真へのアクセスを許可"
          }
        }
      }
    },
    "Allow photo access to see your recent screenshots here" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真へのアクセスを許可すると直近のスクリーンショットがここに並びます"
          }
        }
      }
    },
    "Before you start" : {
      "localizations" : {
