{
  "sourceLanguage" : "en",
  "strings" : {
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Poppo lists your recent screenshots, photos, or videos so you can pick one to translate. Images and videos are read only on this device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直近のスクリーンショット・写真・動画を並べて、翻訳するものを選べるようにします。画像と動画はこの端末の中でだけ読み取ります。"
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "comment" : "Privacy - Screen Capture Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poppo reads the chat on your screen to show translations and reply suggestions on its keyboard. The screen is read only on this device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面のチャットを読み取って、翻訳と返信案をキーボードに出します。画面はこの端末の中でだけ読み取ります。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
