.DS_Store
xcuserdata/
*.xcuserstate
build/
.build/
# 依存の版の pin は Poppo.xcodeproj の Package.resolved だけに置く (これはエディタが package を単体で解決した時に作る)
Packages/*/Package.resolved
DerivedData/
tmp/
.claude/settings.local.json
.envrc
# simtunnel mcp-config が worktree ごとに書き込む接続設定 (セッション固有のためコミットしない)
.mcp.json
# 署名の Team ID などマシン固有の設定 (public リポジトリのため実値をコミットしない)
Config.local.xcconfig

# Firebase のクライアント設定ファイル (API キーを含む)。Firebase を使う構成に変えた時にコミットしないため
lib/firebase_options.dart
**/GoogleService-Info.plist
**/google-services.json

# npm のインストール先 (server/)
node_modules/

# bundler のローカルインストール先
vendor/bundle/
